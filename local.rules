# Educational Snort 2-compatible rules for a controlled lab.
# These are visibility rules. Alerts do not prove malicious activity.
# Keep this ruleset scoped to your own lab capture.

alert icmp any any -> any any (msg:"LAB ICMP echo request observed"; itype:8; sid:1000001; rev:1;)
alert tcp any any -> any any (msg:"LAB TCP SYN packet observed"; flags:S; sid:1000002; rev:1;)
alert udp any any -> any 53 (msg:"LAB DNS traffic observed"; sid:1000003; rev:1;)
